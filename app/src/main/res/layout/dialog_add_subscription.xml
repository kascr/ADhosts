<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            style="@style/Widget.ADHosts.ToolIconContainer">

            <ImageView
                style="@style/Widget.ADHosts.ToolIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_link"
                app:tint="@color/md_theme_primary" />
        </FrameLayout>

        <LinearLayout
            style="@style/Widget.ADHosts.ToolTextGroup">

            <TextView
                style="@style/TextAppearance.ADHosts.DialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_subscription" />

            <TextView
                style="@style/TextAppearance.ADHosts.DialogSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_subscription_hint" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="20dp"
        android:background="@color/md_theme_outlineVariant" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:letterSpacing="0.05"
        android:text="@string/subscription_name_label"
        android:textAllCaps="true"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="12sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.ADHosts.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxStrokeWidth="1.5dp"
        app:endIconMode="clear_text"
        app:endIconTint="@color/md_theme_onSurfaceVariant">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/subscription_name_hint"
            android:imeOptions="actionNext"
            android:inputType="textCapSentences"
            android:paddingVertical="14dp"
            android:singleLine="true"
            android:textColor="@color/md_theme_onSurface"
            android:textColorHint="@color/md_theme_onSurfaceVariant"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:letterSpacing="0.05"
        android:text="@string/subscription_url_label"
        android:textAllCaps="true"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="12sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.ADHosts.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxStrokeWidth="1.5dp"
        app:endIconMode="clear_text"
        app:endIconTint="@color/md_theme_onSurfaceVariant">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/add_subscription_url_example"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:paddingVertical="14dp"
            android:singleLine="true"
            android:textColor="@color/md_theme_onSurface"
            android:textColorHint="@color/md_theme_onSurfaceVariant"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textview.MaterialTextView
        style="@style/TextAppearance.ADHosts.DialogSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="24dp"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:text="@string/add_subscription_tip"
        app:drawableStartCompat="@drawable/ic_network_hint"
        app:drawableTint="@color/md_theme_onSurfaceVariant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.ADHosts.PillButton.TextCompact"
            android:layout_marginEnd="8dp"
            android:text="@string/cancel"
            app:icon="@drawable/ic_close_circle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            style="@style/Widget.ADHosts.PillButton.Success.Compact"
            android:text="@string/confirm"
            app:icon="@drawable/ic_check_circle" />
    </LinearLayout>

</LinearLayout>
