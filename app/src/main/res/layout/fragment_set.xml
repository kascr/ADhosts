<!-- 参考项目 tools.tsx: 分组列表式布局, 每组有标题+连续卡片项 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="140dp">

        <!-- ================================================================== -->
        <!-- 分组1: 传感器工具 -->
        <!-- ================================================================== -->
        <TextView
            style="@style/Widget.ADHosts.ToolSectionHeader"
            android:text="@string/section_sensor_tools"
            />

        <!-- 分贝仪 -->
        <LinearLayout
            android:id="@+id/decibelButton"
            style="@style/Widget.ADHosts.ToolRow.Spaced"
            android:background="@drawable/tool_decibel_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            >

            <FrameLayout
                style="@style/Widget.ADHosts.ToolIconContainer"
                android:backgroundTint="@color/tool_decibel_container">

                <ImageView
                    style="@style/Widget.ADHosts.ToolIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_volume"
                    app:tint="@color/tool_decibel_icon" />
            </FrameLayout>

            <LinearLayout
                style="@style/Widget.ADHosts.ToolTextGroup">

                <TextView
                    style="@style/TextAppearance.ADHosts.RowTitle.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_decibel"
                    />

                <TextView
                    style="@style/TextAppearance.ADHosts.RowSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_decibel_desc"
                    />
            </LinearLayout>

            <TextView
                style="@style/Widget.ADHosts.Tag.Sensor"
                android:text="@string/tool_sensor_tag"
                />

            <ImageView
                style="@style/Widget.ADHosts.RowChevron.Small"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                />
        </LinearLayout>

        <!-- ================================================================== -->
        <!-- 分组2: 系统清理 -->
        <!-- ================================================================== -->
        <TextView
            style="@style/Widget.ADHosts.ToolSectionHeader"
            android:text="@string/section_cleanup"
            />

        <!-- 清理空文件夹 -->
        <LinearLayout
            android:id="@+id/cleanEmpButton"
            style="@style/Widget.ADHosts.ToolRow.Spaced"
            android:background="@drawable/tool_clean_folder_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            >

            <FrameLayout
                style="@style/Widget.ADHosts.ToolIconContainer"
                android:backgroundTint="@color/tool_clean_folder_container">

                <ImageView
                    style="@style/Widget.ADHosts.ToolIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_folder"
                    app:tint="@color/tool_clean_folder_icon" />
            </FrameLayout>

            <LinearLayout
                style="@style/Widget.ADHosts.ToolTextGroup">

                <TextView
                    style="@style/TextAppearance.ADHosts.RowTitle.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_clean_folder"
                    />

                <TextView
                    style="@style/TextAppearance.ADHosts.RowSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_clean_folder_desc"
                    />
            </LinearLayout>

            <TextView
                style="@style/Widget.ADHosts.Tag.Root"
                android:text="@string/tool_root_tag"
                />
        </LinearLayout>

        <!-- 清理空文件 -->
        <LinearLayout
            android:id="@+id/cleanFileButton"
            style="@style/Widget.ADHosts.ToolRow.Spaced"
            android:background="@drawable/tool_clean_file_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            >

            <FrameLayout
                style="@style/Widget.ADHosts.ToolIconContainer"
                android:backgroundTint="@color/tool_clean_file_container">

                <ImageView
                    style="@style/Widget.ADHosts.ToolIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_trash"
                    app:tint="@color/tool_clean_file_icon" />
            </FrameLayout>

            <LinearLayout
                style="@style/Widget.ADHosts.ToolTextGroup">

                <TextView
                    style="@style/TextAppearance.ADHosts.RowTitle.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_clean_file"
                    />

                <TextView
                    style="@style/TextAppearance.ADHosts.RowSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_clean_file_desc"
                    />
            </LinearLayout>

            <TextView
                style="@style/Widget.ADHosts.Tag.Root"
                android:text="@string/tool_root_tag"
                />
        </LinearLayout>

        <!-- 提取壁纸 -->
        <LinearLayout
            android:id="@+id/wallpaperButton"
            style="@style/Widget.ADHosts.ToolRow"
            android:background="@drawable/tool_wallpaper_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            >

            <FrameLayout
                style="@style/Widget.ADHosts.ToolIconContainer"
                android:backgroundTint="@color/tool_wallpaper_container">

                <ImageView
                    style="@style/Widget.ADHosts.ToolIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_image"
                    app:tint="@color/tool_wallpaper_icon" />
            </FrameLayout>

            <LinearLayout
                style="@style/Widget.ADHosts.ToolTextGroup">

                <TextView
                    style="@style/TextAppearance.ADHosts.RowTitle.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_extract_wallpaper"
                    />

                <TextView
                    style="@style/TextAppearance.ADHosts.RowSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_extract_wallpaper_desc"
                    />
            </LinearLayout>

            <TextView
                style="@style/Widget.ADHosts.Tag.Root"
                android:text="@string/tool_root_tag"
                />
        </LinearLayout>

        <!-- ================================================================== -->
        <!-- 分组3: 系统调试 -->
        <!-- ================================================================== -->
        <TextView
            style="@style/Widget.ADHosts.ToolSectionHeader"
            android:text="@string/section_debug"
            />

        <!-- USB 调试 -->
        <LinearLayout
            android:id="@+id/usbButton"
            style="@style/Widget.ADHosts.ToolRow.Spaced"
            android:background="@drawable/tool_usb_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            >

            <FrameLayout
                style="@style/Widget.ADHosts.ToolIconContainer"
                android:backgroundTint="@color/tool_usb_container">

                <ImageView
                    style="@style/Widget.ADHosts.ToolIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_usb"
                    app:tint="@color/tool_usb_icon" />
            </FrameLayout>

            <LinearLayout
                style="@style/Widget.ADHosts.ToolTextGroup">

                <TextView
                    style="@style/TextAppearance.ADHosts.RowTitle.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_usb_debug"
                    />

                <TextView
                    style="@style/TextAppearance.ADHosts.RowSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_usb_debug_desc"
                    />
            </LinearLayout>

            <TextView
                style="@style/Widget.ADHosts.Tag.Root"
                android:text="@string/tool_root_tag"
                />
        </LinearLayout>

        <!-- 无线调试 -->
        <LinearLayout
            android:id="@+id/wifiUsbButton"
            style="@style/Widget.ADHosts.ToolRow.Spaced"
            android:background="@drawable/tool_wifi_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            >

            <FrameLayout
                style="@style/Widget.ADHosts.ToolIconContainer"
                android:backgroundTint="@color/tool_wifi_container">

                <ImageView
                    style="@style/Widget.ADHosts.ToolIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_wifi"
                    app:tint="@color/tool_wifi_icon" />
            </FrameLayout>

            <LinearLayout
                style="@style/Widget.ADHosts.ToolTextGroup">

                <TextView
                    style="@style/TextAppearance.ADHosts.RowTitle.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_wireless_debug"
                    />

                <TextView
                    style="@style/TextAppearance.ADHosts.RowSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_wireless_debug_desc"
                    />
            </LinearLayout>

            <TextView
                style="@style/Widget.ADHosts.Tag.Root"
                android:text="@string/tool_root_tag"
                />
        </LinearLayout>

        <!-- 禁止充电 -->
        <LinearLayout
            android:id="@+id/disableChargeButton"
            style="@style/Widget.ADHosts.ToolRow.Spaced"
            android:background="@drawable/tool_disable_charge_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            >

            <FrameLayout
                style="@style/Widget.ADHosts.ToolIconContainer"
                android:backgroundTint="@color/tool_disable_charge_container">

                <ImageView
                    style="@style/Widget.ADHosts.ToolIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_battery"
                    app:tint="@color/tool_disable_charge_icon" />
            </FrameLayout>

            <LinearLayout
                style="@style/Widget.ADHosts.ToolTextGroup">

                <TextView
                    style="@style/TextAppearance.ADHosts.RowTitle.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_disable_charge"
                    />

                <TextView
                    style="@style/TextAppearance.ADHosts.RowSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_disable_charge_desc"
                    />
            </LinearLayout>

            <TextView
                style="@style/Widget.ADHosts.Tag.Root"
                android:text="@string/tool_root_tag"
                />
        </LinearLayout>

        <!-- 恢复充电 -->
        <LinearLayout
            android:id="@+id/enableChargeButton"
            style="@style/Widget.ADHosts.ToolRow"
            android:background="@drawable/tool_enable_charge_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            >

            <FrameLayout
                style="@style/Widget.ADHosts.ToolIconContainer"
                android:backgroundTint="@color/tool_enable_charge_container">

                <ImageView
                    style="@style/Widget.ADHosts.ToolIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_battery_charge"
                    app:tint="@color/tool_enable_charge_icon" />
            </FrameLayout>

            <LinearLayout
                style="@style/Widget.ADHosts.ToolTextGroup">

                <TextView
                    style="@style/TextAppearance.ADHosts.RowTitle.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_enable_charge"
                    />

                <TextView
                    style="@style/TextAppearance.ADHosts.RowSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_enable_charge_desc"
                    />
            </LinearLayout>

            <TextView
                style="@style/Widget.ADHosts.Tag.Root"
                android:text="@string/tool_root_tag"
                />
        </LinearLayout>

        <!-- ================================================================== -->
        <!-- 分组4: 其他 -->
        <!-- ================================================================== -->
        <TextView
            style="@style/Widget.ADHosts.ToolSectionHeader"
            android:text="@string/section_other"
            />

        <!-- 杀死后台播放器 -->
        <LinearLayout
            android:id="@+id/killMp4Button"
            style="@style/Widget.ADHosts.ToolRow"
            android:background="@drawable/tool_kill_player_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            >

            <FrameLayout
                style="@style/Widget.ADHosts.ToolIconContainer"
                android:backgroundTint="@color/tool_kill_player_container">

                <ImageView
                    style="@style/Widget.ADHosts.ToolIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_close_circle"
                    app:tint="@color/tool_kill_player_icon" />
            </FrameLayout>

            <LinearLayout
                style="@style/Widget.ADHosts.ToolTextGroup">

                <TextView
                    style="@style/TextAppearance.ADHosts.RowTitle.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_kill_player"
                    />

                <TextView
                    style="@style/TextAppearance.ADHosts.RowSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tool_kill_player_desc"
                    />
            </LinearLayout>

            <TextView
                style="@style/Widget.ADHosts.Tag.Root"
                android:text="@string/tool_root_tag"
                />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
