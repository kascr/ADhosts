<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_glass_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                style="@style/Widget.ADHosts.ToolIconContainer"
                android:background="@drawable/hosts_panel_icon_bg">

                <ImageView
                    style="@style/Widget.ADHosts.ToolIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/md_theme_primary" />
            </FrameLayout>

            <LinearLayout
                style="@style/Widget.ADHosts.ToolTextGroup">

                <TextView
                    style="@style/TextAppearance.ADHosts.DialogTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recommended_sources_title" />

                <TextView
                    style="@style/TextAppearance.ADHosts.DialogSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recommended_sources_hint" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="@color/md_theme_outlineVariant" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ADHosts.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/appCardHighBackgroundColor">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextAppearance.ADHosts.RowTitle.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recommended_autumn_name" />

                <TextView
                    style="@style/TextAppearance.ADHosts.RowSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/recommended_autumn_summary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/sensor_badge_bg"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="@string/recommended_hosts_tag"
                    android:textColor="#FFD3D1FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/autumnWebsiteButton"
                        style="@style/Widget.ADHosts.PillButton.Website.Compact"
                        android:layout_marginEnd="8dp"
                        android:text="@string/recommended_website"
                        app:icon="@drawable/ic_link" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/autumnAddButton"
                        style="@style/Widget.ADHosts.PillButton.Add.Compact"
                        android:text="@string/btn_add"
                        app:icon="@drawable/ic_add" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ADHosts.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/appCardHighBackgroundColor">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextAppearance.ADHosts.RowTitle.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recommended_github520_name" />

                <TextView
                    style="@style/TextAppearance.ADHosts.RowSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/recommended_github520_summary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/sensor_badge_bg"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="@string/recommended_hosts_tag"
                    android:textColor="#FFD3D1FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/github520WebsiteButton"
                        style="@style/Widget.ADHosts.PillButton.Website.Compact"
                        android:layout_marginEnd="8dp"
                        android:text="@string/recommended_website"
                        app:icon="@drawable/ic_link" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/github520AddButton"
                        style="@style/Widget.ADHosts.PillButton.Add.Compact"
                        android:text="@string/btn_add"
                        app:icon="@drawable/ic_add" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeButton"
            style="@style/Widget.ADHosts.PillButton.TextCompact"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:text="@string/cancel"
            app:icon="@drawable/ic_close_circle" />
    </LinearLayout>
</ScrollView>
