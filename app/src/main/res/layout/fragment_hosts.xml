<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="0dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statusCard"
            style="@style/Widget.ADHosts.HighlightCard"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/md_hosts_status_panel"
            app:strokeColor="@color/md_hosts_status_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                style="@style/Widget.ADHosts.HighlightCard.Content">

                <FrameLayout
                    android:id="@+id/statusIconContainer"
                    style="@style/Widget.ADHosts.StatusIconContainer"
                    android:background="@drawable/hosts_status_icon_bg">

                    <ImageView
                        android:id="@+id/statusIcon"
                        style="@style/Widget.ADHosts.StatusIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/md_theme_primary" />
                </FrameLayout>

                <LinearLayout
                    style="@style/Widget.ADHosts.StatusTextGroup">

                    <TextView
                        android:id="@+id/statusText"
                        style="@style/TextAppearance.ADHosts.StatusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hosts_checking_status" />

                    <TextView
                        android:id="@+id/statusRulesText"
                        style="@style/TextAppearance.ADHosts.StatusSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hosts_checking_status_hint"
                        android:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openButton"
                style="@style/Widget.ADHosts.PillButton.Success"
                android:layout_marginEnd="4dp"
                android:text="@string/open_hosts"
                app:icon="@drawable/ic_check_circle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/closeButton"
                style="@style/Widget.ADHosts.PillButton.Danger"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:text="@string/close_hosts"
                app:icon="@drawable/ic_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/updateButton"
                style="@style/Widget.ADHosts.PillButton.Neutral"
                android:layout_marginStart="4dp"
                android:text="@string/update_subscription"
                app:icon="@drawable/ic_sync" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dnsChip"
            style="@style/Widget.ADHosts.InfoRow"
            android:layout_marginBottom="10dp"
            android:background="@drawable/hosts_panel_bg">

            <FrameLayout
                style="@style/Widget.ADHosts.ToolIconContainer"
                android:background="@drawable/hosts_panel_icon_bg">

                <ImageView
                    style="@style/Widget.ADHosts.ToolIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_network"
                    app:tint="@color/md_theme_primary" />
            </FrameLayout>

            <LinearLayout
                style="@style/Widget.ADHosts.ToolTextGroup">

                <TextView
                    style="@style/TextAppearance.ADHosts.RowTitle.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/current_dns" />

                <TextView
                    android:id="@+id/dnsValueText"
                    style="@style/TextAppearance.ADHosts.RowSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/restore_default" />
            </LinearLayout>

            <ImageView
                style="@style/Widget.ADHosts.RowChevron.Small"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/manualRulesCard"
            style="@style/Widget.ADHosts.InfoRow"
            android:layout_marginBottom="10dp"
            android:background="@drawable/hosts_panel_bg"
            android:visibility="gone">

            <FrameLayout
                style="@style/Widget.ADHosts.ToolIconContainer"
                android:background="@drawable/hosts_panel_icon_bg">

                <ImageView
                    style="@style/Widget.ADHosts.ToolIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_wrench"
                    app:tint="@color/md_theme_primary" />
            </FrameLayout>

            <LinearLayout style="@style/Widget.ADHosts.ToolTextGroup">

                <TextView
                    style="@style/TextAppearance.ADHosts.RowTitle.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/manual_hosts_rules" />

                <TextView
                    android:id="@+id/manualRulesCountText"
                    style="@style/TextAppearance.ADHosts.RowSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ImageView
                style="@style/Widget.ADHosts.RowChevron.Small"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/subscriptionTitle"
                style="@style/TextAppearance.ADHosts.RowTitle.Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/subscription_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recommendedButton"
                style="@style/Widget.ADHosts.PillButton.Recommended.Compact"
                android:layout_marginEnd="8dp"
                android:text="@string/btn_recommended"
                app:icon="@drawable/ic_shield" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/outlinedButton"
                style="@style/Widget.ADHosts.PillButton.Neutral.Compact"
                android:text="@string/btn_add"
                app:icon="@drawable/ic_add" />
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="140dp"
            tools:listitem="@layout/item_subscription" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/emptyText"
            style="@style/TextAppearance.ADHosts.RowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="16dp"
            android:drawablePadding="12dp"
            android:gravity="center"
            android:text="@string/empty_subscription_hint"
            android:visibility="gone"
            app:drawableTint="@color/md_theme_secondary"
            app:drawableTopCompat="@drawable/ic_link_empty" />

    </FrameLayout>
</LinearLayout>
