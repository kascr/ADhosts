<?xml version="1.0" encoding="utf-8"?>
<com.kascr.adhosts.ui.widget.SubscriptionSwipeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/deleteActionCard"
        style="@style/Widget.ADHosts.SubscriptionDeleteCard"
        android:layout_gravity="end"
        android:visibility="invisible">

        <TextView
            android:id="@+id/deleteActionText"
            style="@style/Widget.ADHosts.SubscriptionDeleteText"
            android:text="@string/btn_delete"
            />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/contentCard"
        style="@style/Widget.ADHosts.SubscriptionCard"
        app:cardBackgroundColor="@color/subscription_card"
        app:strokeColor="@color/subscription_card_stroke"
        app:strokeWidth="0.5dp">

        <LinearLayout
            style="@style/Widget.ADHosts.SubscriptionRow">

            <FrameLayout
                style="@style/Widget.ADHosts.ToolIconContainer"
                android:background="@drawable/hosts_panel_icon_bg">

                <ImageView
                    style="@style/Widget.ADHosts.ToolIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_link"
                    app:tint="@color/md_theme_primary" />
            </FrameLayout>

            <LinearLayout
                style="@style/Widget.ADHosts.ToolTextGroup">

                <TextView
                    android:id="@+id/subscriptionNameText"
                    style="@style/TextAppearance.ADHosts.RowTitle.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="My hosts subscription" />

                <TextView
                    android:id="@+id/subscriptionText"
                    style="@style/TextAppearance.ADHosts.RowSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    tools:text="https://example.com/hosts.txt" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/subscriptionEnabledSwitch"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/subscription_switch"
                android:minWidth="48dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</com.kascr.adhosts.ui.widget.SubscriptionSwipeLayout>
