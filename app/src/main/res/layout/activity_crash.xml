<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/crashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/crash_screen_background"
    tools:context=".ui.activity.CrashActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/crashContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/crash_icon_background">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_crash_warning"
                        app:tint="#FFFFB4AB" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/crash_title"
                        android:textColor="#FFF3EDF7"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/crash_subtitle"
                        android:textColor="#FFC9C5D0"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/crashLoopWarning"
                style="@style/Widget.ADHosts.CrashCard.Error"
                android:layout_marginTop="18dp"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:text="@string/crash_loop_warning"
                    android:textColor="#FFFFDAD6"
                    android:textSize="13sp"
                    app:drawableStartCompat="@drawable/ic_crash_warning"
                    app:drawableTint="#FFFFB4AB" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ADHosts.CrashCard"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/TextAppearance.ADHosts.CrashSectionTitle"
                        android:text="@string/crash_environment" />

                    <TextView
                        style="@style/TextAppearance.ADHosts.CrashInfoLabel"
                        android:layout_marginTop="16dp"
                        android:text="@string/crash_app_version" />

                    <TextView
                        android:id="@+id/crashAppValue"
                        style="@style/TextAppearance.ADHosts.CrashInfoValue"
                        tools:text="2.2.0 (220)" />

                    <TextView
                        style="@style/TextAppearance.ADHosts.CrashInfoLabel"
                        android:layout_marginTop="12dp"
                        android:text="@string/crash_time" />

                    <TextView
                        android:id="@+id/crashTimeValue"
                        style="@style/TextAppearance.ADHosts.CrashInfoValue"
                        tools:text="2026-09-18 21:36:42 +0800" />

                    <TextView
                        style="@style/TextAppearance.ADHosts.CrashInfoLabel"
                        android:layout_marginTop="12dp"
                        android:text="@string/crash_system" />

                    <TextView
                        android:id="@+id/crashSystemValue"
                        style="@style/TextAppearance.ADHosts.CrashInfoValue"
                        tools:text="Android 16 (API 36)" />

                    <TextView
                        style="@style/TextAppearance.ADHosts.CrashInfoLabel"
                        android:layout_marginTop="12dp"
                        android:text="@string/crash_device" />

                    <TextView
                        android:id="@+id/crashDeviceValue"
                        style="@style/TextAppearance.ADHosts.CrashInfoValue"
                        tools:text="Google / Pixel 9 / tokay" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ADHosts.CrashCard.Error"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/TextAppearance.ADHosts.CrashSectionTitle"
                        android:text="@string/crash_exception_summary" />

                    <TextView
                        android:id="@+id/crashExceptionName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="monospace"
                        android:textColor="#FFFFB4AB"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="IllegalStateException" />

                    <TextView
                        android:id="@+id/crashExceptionMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#FFE6E0E9"
                        android:textIsSelectable="true"
                        android:textSize="14sp"
                        tools:text="Unable to complete the requested operation" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/crashStackToggle"
                style="@style/Widget.ADHosts.CrashDetailsButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/crash_expand_details"
                app:icon="@drawable/ic_expand_more" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/crashStackContainer"
                style="@style/Widget.ADHosts.CrashCodeCard"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:overScrollMode="ifContentScrolls">

                    <TextView
                        android:id="@+id/crashStackText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="280dp"
                        android:fontFamily="monospace"
                        android:padding="16dp"
                        android:textColor="#FFD8D4DD"
                        android:textIsSelectable="true"
                        android:textSize="11sp"
                        tools:text="java.lang.IllegalStateException: Example\n    at com.kascr.adhosts.Main.run(Main.kt:42)" />
                </HorizontalScrollView>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/crash_privacy_hint"
                android:textColor="#FF948F99"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/crashRestartButton"
                    style="@style/Widget.ADHosts.CrashButton.Primary"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/crash_restart"
                    app:icon="@drawable/ic_restart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/crashCopyButton"
                    style="@style/Widget.ADHosts.CrashButton.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/crash_copy"
                    app:icon="@drawable/ic_copy" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/crashShareButton"
                    style="@style/Widget.ADHosts.CrashButton.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/crash_share"
                    app:icon="@drawable/ic_share" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/crashExitButton"
                    style="@style/Widget.ADHosts.CrashButton.Danger"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/crash_exit"
                    app:icon="@drawable/ic_exit" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
