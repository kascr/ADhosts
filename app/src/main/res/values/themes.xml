<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base app theme -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Material 3 color roles -->
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_onBackground</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_outlineVariant</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_surfaceContainerHigh</item>
        <item name="colorSurfaceContainer">@color/md_theme_surfaceContainer</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_surfaceContainerLow</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_surfaceContainerHighest</item>

        <!-- App-specific surfaces -->
        <item name="mainBackgroundScrimColor">#66121318</item>
        <item name="appCardBackgroundColor">#B01E1F25</item>
        <item name="appCardHighBackgroundColor">#C0292A2F</item>
        <item name="appCardStrokeColor">#80B7CFFF</item>
        <item name="appIconContainerBackgroundColor">@color/md_theme_secondaryContainer</item>
        <item name="appSelectedNavPillColor">#B05C4FB0</item>
        <item name="appNavGlassBackgroundColor">#D52A4160</item>
        <item name="appStatusEnabledBackgroundColor">#CC563B8A</item>
        <item name="appStatusDisabledBackgroundColor">#CC93000A</item>
        <item name="appStatusPendingBackgroundColor">#CC604100</item>
        <item name="appStatusCheckingBackgroundColor">#B0292A2F</item>

        <!-- Shared widget defaults -->
        <item name="materialButtonStyle">@style/Widget.ADHosts.Button</item>
        <item name="materialCardViewStyle">@style/Widget.ADHosts.Card</item>
        <item name="textInputStyle">@style/Widget.ADHosts.TextInputLayout</item>

        <!-- System bars -->
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@color/md_theme_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Disable activity transition animations for smoother recreate/splash handoff -->
    <style name="AppTheme.NoAnimation" parent="AppTheme">
        <item name="android:windowAnimationStyle">@style/NoAnimation</item>
    </style>

    <!-- More transparent surface set used when a custom background image is active -->
    <style name="AppTheme.NoAnimation.Background" parent="AppTheme.NoAnimation">
        <item name="mainBackgroundScrimColor">#66121318</item>
        <item name="appCardBackgroundColor">#991E1F25</item>
        <item name="appCardHighBackgroundColor">#B3292A2F</item>
        <item name="appCardStrokeColor">#90C5D8FF</item>
        <item name="appIconContainerBackgroundColor">#99454559</item>
        <item name="appSelectedNavPillColor">#B8665BC4</item>
        <item name="appNavGlassBackgroundColor">#E02A4160</item>
        <item name="appStatusEnabledBackgroundColor">#80563B8A</item>
        <item name="appStatusDisabledBackgroundColor">#6B93000A</item>
        <item name="appStatusPendingBackgroundColor">#6B604100</item>
        <item name="appStatusCheckingBackgroundColor">#66292A2F</item>
    </style>

    <style name="AppTheme.Crash" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#FFBDC7FF</item>
        <item name="colorOnPrimary">#FF202A5C</item>
        <item name="colorSurface">#FF17181E</item>
        <item name="colorOnSurface">#FFF3EDF7</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@drawable/crash_screen_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="NoAnimation">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:taskOpenEnterAnimation">@null</item>
        <item name="android:taskOpenExitAnimation">@null</item>
    </style>

    <style name="Widget.ADHosts.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/appCardBackgroundColor</item>
        <item name="cardCornerRadius">@dimen/app_card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/appCardStrokeColor</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.ADHosts.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">20dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.ADHosts.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/md_theme_surfaceContainerHigh</item>
        <item name="boxStrokeColor">@color/md_theme_outline</item>
        <item name="hintTextColor">@color/md_theme_onSurfaceVariant</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>
</resources>
